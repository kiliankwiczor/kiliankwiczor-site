# Variables shell du backend ; aucune clé cloud nécessaire pour le pilote.
DATABASE_URL=postgres://mova:mova_local_only@127.0.0.1:5433/mova
PORT=3001
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Mobile : variable publique, pas de secret. Sur téléphone utiliser une adresse
# de développement accessible depuis le téléphone, servie en HTTPS hors LAN privé.
EXPO_PUBLIC_API_URL=http://localhost:3001
